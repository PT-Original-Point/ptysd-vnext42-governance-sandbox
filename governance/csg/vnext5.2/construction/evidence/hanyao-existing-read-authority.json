      "final_strategic_goal": "Make HANYAO Google Ads -> LINE conversion tracking independently auditable and cross-session resumable so any target date can be classified from canonical D1 lineage and fresh Google Ads reporting without blind resend or inferred project identity.",
      "success_criteria": "PROJECT_DIRECTORY_EXACT_RESOLUTION=PASS; HG10_READBACK_WORKFLOW=PASS; D1_READ_ONLY_GUARD=PASS; GOOGLE_ADS_DATE_READBACK=PASS; TARGET_DATE_VERDICT=CLASSIFIED; NO_BLIND_REINGEST=true; PRODUCTION_DELIVERY_PATH_UNCHANGED=true; CROSS_SESSION_RESUME_LOCATOR=PASS",
