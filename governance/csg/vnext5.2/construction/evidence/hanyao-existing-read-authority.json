      "governance_invariants": "HUMAN_MISSION_SOVEREIGNTY; EXACT_PROJECT_DIRECTORY_IDENTITY; FRESH_PROVIDER_READBACK; READ_ONLY_INSPECTION_ZERO_WRITES; UNKNOWN_EFFECT_READBACK_FIRST; SINGLE_CANONICAL_PRODUCTION_D1; SINGLE_PRODUCTION_UPLOADER; IMMUTABLE_ATTRIBUTION_SNAPSHOT; GOOGLE_ADS_REPORTING_REQUIRED_FOR_CLOSURE; NO_BLIND_RETRY",
      "non_goals": "No campaign creative optimization; no bidding/budget/goal strategy changes; no duplicate conversion upload; no replacement of the Production uploader/outbox architecture; no second workflow engine."
    },
