{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ptysd.invalid/schemas/csg/authorization-state.v2.schema.json",
  "title":"AuthorizationStateV2",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","project_id","mission_revision","mission_hash","status","current_authorization_id","authorization_generation","previous_state_digest","supersedes","revoked_authorization_ids","human_authorization_ref","recorded_at","state_digest"],
  "properties":{
    "schema":{"const":"v49.authorization-state.v2"},
    "project_id":{"type":"string","minLength":1,"maxLength":128},
    "mission_revision":{"type":"string","minLength":1,"maxLength":256},
    "mission_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "status":{"enum":["ACTIVE","SUSPENDED","REVOKED"]},
    "current_authorization_id":{"type":["string","null"],"maxLength":128},
    "authorization_generation":{"type":"integer","minimum":1,"maximum":2147483647},
    "previous_state_digest":{"type":["string","null"],"pattern":"^sha256:[0-9a-f]{64}$"},
    "supersedes":{"type":["string","null"],"maxLength":128},
    "revoked_authorization_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":128}},
    "human_authorization_ref":{"type":"string","minLength":1,"maxLength":1024},
    "recorded_at":{"type":"string","minLength":1,"maxLength":128},
    "state_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  },
  "allOf":[
    {"if":{"properties":{"status":{"const":"ACTIVE"}}},"then":{"properties":{"current_authorization_id":{"type":"string","minLength":1}}}},
    {"if":{"properties":{"status":{"enum":["SUSPENDED","REVOKED"]}}},"then":{"properties":{"current_authorization_id":{"type":"null"}}}}
  ]
}