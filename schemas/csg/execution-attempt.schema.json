{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ptysd.invalid/schemas/csg/execution-attempt.v1.schema.json",
  "title":"ExecutionAttempt",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","project_id","mission_revision","mission_hash","authorization_envelope_digest","authorization_generation","authorization_state_digest","run_id","atomic_unit_id","attempt_id","attempt_epoch","operation_id","state","started_at","deadline","finished_at","executor","tool","route","mutation_class","provider_precondition","idempotency_key","side_effect_state","readback_state","dispatch_count","readback_count","terminal_reason","last_dispatch_observed_at","last_provider_observation_ref","retry_of_attempt_id","retry_of_attempt_epoch","attempt_digest"],
  "properties":{
    "schema":{"const":"v49.execution-attempt.v1"},
    "project_id":{"type":"string","minLength":1,"maxLength":128},
    "mission_revision":{"type":"string","minLength":1,"maxLength":256},
    "mission_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "authorization_envelope_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "authorization_generation":{"type":"integer","minimum":1,"maximum":2147483647},
    "authorization_state_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "run_id":{"type":"string","minLength":1,"maxLength":128},
    "atomic_unit_id":{"type":"string","minLength":1,"maxLength":128},
    "attempt_id":{"type":"string","minLength":1,"maxLength":128},
    "attempt_epoch":{"type":"integer","minimum":1,"maximum":2147483647},
    "operation_id":{"type":"string","minLength":1,"maxLength":128},
    "state":{"enum":["READY","DISPATCHING","READBACK_REQUIRED","RECOVERY_REQUIRED","COMPLETED","FAILED"]},
    "started_at":{"type":"string","minLength":1,"maxLength":128},
    "deadline":{"type":"string","minLength":1,"maxLength":128},
    "finished_at":{"type":["string","null"],"maxLength":128},
    "executor":{"type":"string","minLength":1,"maxLength":128},
    "tool":{"type":"string","minLength":1,"maxLength":128},
    "route":{"type":"string","minLength":1,"maxLength":128},
    "mutation_class":{"enum":["LOCAL_PREPARATION","LOCAL_EXECUTION","PROVIDER_EFFECT","HUMAN_RESERVED"]},
    "provider_precondition":{"type":"object","minProperties":1,"maxProperties":16},
    "idempotency_key":{"type":"string","minLength":1,"maxLength":256},
    "side_effect_state":{"enum":["NONE","PENDING","UNKNOWN","APPLIED","NOT_APPLIED","PARTIAL_OR_AMBIGUOUS"]},
    "readback_state":{"enum":["NOT_REQUIRED","REQUIRED","CONFIRMED_APPLIED","CONFIRMED_NOT_APPLIED","PARTIAL_OR_AMBIGUOUS"]},
    "dispatch_count":{"type":"integer","minimum":0,"maximum":1},
    "readback_count":{"type":"integer","minimum":0},
    "terminal_reason":{"type":["string","null"],"maxLength":128},
    "last_dispatch_observed_at":{"type":["string","null"],"maxLength":128},
    "last_provider_observation_ref":{"type":["string","null"],"maxLength":2048},
    "retry_of_attempt_id":{"type":["string","null"],"maxLength":128},
    "retry_of_attempt_epoch":{"type":["integer","null"],"minimum":1,"maximum":2147483647},
    "attempt_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  }
}