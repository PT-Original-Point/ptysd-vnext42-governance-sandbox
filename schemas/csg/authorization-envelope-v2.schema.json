{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ptysd.invalid/schemas/csg/authorization-envelope.v2.schema.json",
  "title":"AuthorizationEnvelopeV2",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","authorization_id","authorization_generation","supersedes","project_id","mission_revision","mission_hash","valid_until_mission_revision","scope_tags","allowed_mutation_classes","forbidden_actions","human_reservations","human_authorization_ref","issued_at","revoked_at","revocation_ref","envelope_digest"],
  "properties":{
    "schema":{"const":"v49.authorization-envelope.v2"},
    "authorization_id":{"type":"string","minLength":1,"maxLength":128},
    "authorization_generation":{"type":"integer","minimum":1,"maximum":2147483647},
    "supersedes":{"type":["string","null"],"maxLength":128},
    "project_id":{"type":"string","minLength":1,"maxLength":128},
    "mission_revision":{"type":"string","minLength":1,"maxLength":256},
    "mission_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "valid_until_mission_revision":{"type":"string","minLength":1,"maxLength":256},
    "scope_tags":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":128}},
    "allowed_mutation_classes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["LOCAL_PREPARATION","LOCAL_EXECUTION","PROVIDER_EFFECT","HUMAN_RESERVED"]}},
    "forbidden_actions":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":128}},
    "human_reservations":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":128}},
    "human_authorization_ref":{"type":"string","minLength":1,"maxLength":1024},
    "issued_at":{"type":"string","minLength":1,"maxLength":128},
    "revoked_at":{"type":["string","null"],"maxLength":128},
    "revocation_ref":{"type":["string","null"],"maxLength":2048},
    "envelope_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  }
}
