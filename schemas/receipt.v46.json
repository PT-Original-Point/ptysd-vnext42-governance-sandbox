{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://pt-original-point.invalid/schemas/receipt.v46.json",
  "title":"VNEXT4.6 Factory Receipt Candidate",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","receipt_id","project_id","run_id","task_id","attempt_id","attempt_epoch","contract_id","contract_sha256","candidate_sha256","verifier_sha256","resource_identity","result","evidence_refs","unresolved_operation_ids","stop_requested"],
  "properties":{
    "schema":{"const":"factory.receipt.v46"},
    "receipt_id":{"type":"string","minLength":1},
    "project_id":{"type":"string","minLength":1},
    "run_id":{"type":"string","minLength":1},
    "task_id":{"type":"string","minLength":1},
    "attempt_id":{"type":"string","minLength":1},
    "attempt_epoch":{"type":"integer","minimum":0},
    "contract_id":{"type":"string","minLength":1},
    "contract_sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "candidate_sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "verifier_sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "resource_identity":{"type":"string","minLength":1},
    "result":{"enum":["PASS","FAIL","WAITING_RESOURCE","BLOCKED"]},
    "evidence_refs":{"type":"array","minItems":1,"items":{"type":"string","minLength":1},"uniqueItems":true},
    "unresolved_operation_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "stop_requested":{"type":"boolean"}
  }
}
