{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://ptysd.invalid/schemas/v47/contract.schema.json",
  "title":"PTYSD V4.7 bounded task graph contract",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","canonicalizer_version","contract_id","project_id","run_id","revision","plan_id","spec_revision","spec_digest","base_commit","base_tree","tasks","active_window_task_ids","root_budgets"],
  "properties":{
    "schema_version":{"const":"factory.contract.v47"},
    "canonicalizer_version":{"const":"v47-json-c14n-1"},
    "contract_id":{"$ref":"#/$defs/id"},
    "project_id":{"$ref":"#/$defs/id"},
    "run_id":{"$ref":"#/$defs/id"},
    "revision":{"type":"integer","minimum":1,"maximum":2147483647},
    "plan_id":{"$ref":"#/$defs/id"},
    "spec_revision":{"type":"integer","minimum":1,"maximum":2147483647},
    "spec_digest":{"$ref":"#/$defs/digest"},
    "base_commit":{"$ref":"#/$defs/git"},
    "base_tree":{"$ref":"#/$defs/git"},
    "tasks":{"type":"array","minItems":1,"maxItems":96,"items":{"$ref":"#/$defs/task"}},
    "active_window_task_ids":{"type":"array","minItems":1,"maxItems":12,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
    "root_budgets":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/rootBudget"}}
  },
  "$defs":{
    "id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "git":{"type":"string","pattern":"^[0-9a-f]{40,64}$"},
    "path":{"type":"string","minLength":1},
    "interface":{"type":"object","additionalProperties":false,"required":["interface_id","digest","mode"],"properties":{"interface_id":{"$ref":"#/$defs/id"},"digest":{"$ref":"#/$defs/digest"},"mode":{"enum":["READ","WRITE","MIGRATION"]}}},
    "resource":{"type":"object","additionalProperties":false,"required":["cpu_millis","memory_mib","pids","disk_mib","network_mode","api_calls"],"properties":{
      "cpu_millis":{"type":"integer","minimum":1,"maximum":64000},
      "memory_mib":{"type":"integer","minimum":16,"maximum":262144},
      "pids":{"type":"integer","minimum":1,"maximum":4096},
      "disk_mib":{"type":"integer","minimum":1,"maximum":1048576},
      "network_mode":{"enum":["DENY","LIMITED"]},
      "api_calls":{"type":"integer","minimum":0,"maximum":10000}
    }},
    "artifact":{"type":"object","additionalProperties":false,"required":["path","kind","max_bytes"],"properties":{"path":{"$ref":"#/$defs/path"},"kind":{"enum":["FILE","DIRECTORY","RECEIPT"]},"max_bytes":{"type":"integer","minimum":1,"maximum":1073741824}}},
    "rootBudget":{"type":"object","additionalProperties":false,"required":["root_task_id","max_candidates","max_replans"],"properties":{"root_task_id":{"$ref":"#/$defs/id"},"max_candidates":{"type":"integer","minimum":1,"maximum":3},"max_replans":{"type":"integer","minimum":0,"maximum":1}}},
    "task":{"type":"object","additionalProperties":false,
      "required":["task_id","root_task_id","depends_on","owned_paths","read_paths","forbidden_paths","shared_interfaces","requirement_ids","acceptance_case_ids","data_class","risk_class","model_profile_id","resource_request","expected_artifacts","review_policy","merge_policy","timeout_seconds"],
      "properties":{
        "task_id":{"$ref":"#/$defs/id"},"root_task_id":{"$ref":"#/$defs/id"},
        "depends_on":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
        "owned_paths":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/path"}},
        "read_paths":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/path"}},
        "forbidden_paths":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/path"}},
        "shared_interfaces":{"type":"array","items":{"$ref":"#/$defs/interface"}},
        "requirement_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
        "acceptance_case_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
        "data_class":{"enum":["PUBLIC","SYNTHETIC"]},
        "risk_class":{"enum":["LOW","MEDIUM","HIGH"]},
        "model_profile_id":{"$ref":"#/$defs/id"},
        "resource_request":{"$ref":"#/$defs/resource"},
        "expected_artifacts":{"type":"array","items":{"$ref":"#/$defs/artifact"}},
        "review_policy":{"enum":["FRESH_REQUIRED","NONE"]},
        "merge_policy":{"enum":["SERIAL_INTEGRATOR","NO_MERGE"]},
        "timeout_seconds":{"type":"integer","minimum":1,"maximum":3600}
      }
    }
  }
}
