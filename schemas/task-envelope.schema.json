  "$id": "PTYSD_TASK_ENVELOPE_V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","task_id","project_id","interrupt_epoch","objective","provider_write","allowed_paths","evidence_required"],
  "properties": {
    "schema": { "const": "PTYSD_TASK_ENVELOPE_V1" },
    "task_id": { "type": "string", "minLength": 1 },
    "project_id": { "const": "CHATGPT_GLOBAL_SKILL_GOVERNANCE" },
    "interrupt_epoch": { "type": "integer", "minimum": 0 },
    "objective": { "type": "string", "minLength": 1 },
    "provider_write": { "const": false },
    "allowed_paths": { "type": "array", "items": { "type": "string" } },
    "evidence_required": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
