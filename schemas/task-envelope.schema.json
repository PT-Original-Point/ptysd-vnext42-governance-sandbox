{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PTYSD_TASK_ENVELOPE_V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","task_id","project_id","owner_principal_id","owner_session_id","provider_session_id","interrupt_epoch","owner_generation","objective","provider_write","allowed_paths","evidence_required"],
  "properties": {
    "schema": { "const": "PTYSD_TASK_ENVELOPE_V1" },
    "task_id": { "type": "string", "minLength": 1 },
    "project_id": { "const": "CHATGPT_GLOBAL_SKILL_GOVERNANCE" },
    "owner_principal_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "owner_session_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "provider_session_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "interrupt_epoch": { "type": "integer", "minimum": 0 },
    "owner_generation": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "objective": { "type": "string", "minLength": 1 },
    "attempt_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "attempt_epoch": { "type": "integer", "minimum": 0 },
    "provider": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "provider_write": { "const": false },
    "allowed_paths": { "type": "array", "items": { "type": "string" } },
    "evidence_required": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
